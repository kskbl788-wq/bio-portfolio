# ============================================================
#  .gitignore —— 告诉 Git "哪些文件不用管"
#  语法：每行一个规则；# 开头是注释；末尾的 / 表示目录
#  如果某个文件被误忽略了但确实要提交，可以临时用：git add -f 文件名
# ============================================================

# ---------- 操作系统自动生成 ----------
# Windows 缩略图缓存等
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS 访达生成的隐藏文件
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ---------- 编辑器 / IDE 配置 ----------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# JetBrains (PyCharm / CLion 等)
.idea/
*.iml
out/

# 其它编辑器
*.swp
*.swo
*~
.vim/

# ---------- Python ----------
# 字节码与解释器缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境（体积大、每台机器都能重建，不该进仓库）
.venv/
venv/
env/
ENV/
.conda/

# 打包与分发
build/
dist/
*.egg-info/
.eggs/
wheels/

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ---------- Jupyter Notebook ----------
# 检查点目录（自动备份文件，无需提交）
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# 导出内容，按需保留
# !/exports/

# ---------- R / RStudio（生物统计常用） ----------
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/

# ---------- Office 临时文件 ----------
# 打开 Word/Excel/PPT 时产生的隐藏临时文件
~$*.doc*
~$*.xls*
~$*.ppt*
*.tmp
*.temp

# ---------- 数据与密钥（重要！） ----------
# 实验原始数据往往很大，且可能有伦理/隐私要求，默认不提交
# 数据请放网盘或学校服务器，仓库里只放"处理脚本"
data/raw/
raw_data/
*.csv.gz
*.parquet
*.h5
*.hdf5

# 环境变量与密钥绝不能进仓库
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
secrets.json

# ---------- 日志与临时输出 ----------
*.log
logs/
results/tmp/
.cache/
